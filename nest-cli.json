{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "outputDir": "dist",
    "assets": [
      {
        "include": "assistant/artifacts/**/*",
        "watchAssets": true,
        "outDir": "dist/src"
      }
    ]
  }
}
