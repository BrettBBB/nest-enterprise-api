# Copy to .env. The app reads this file via `nest start --env-file .env`.

# Postgres connection used by Prisma and the API. `pnpm exec prisma dev -d` prints a local URL.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1"

# Required. JwtAuthModule throws on startup when this is missing.
# Use a long random value. Do not commit the real secret.
JWT_SECRET="replace-with-a-long-random-string"

# Optional. Comma-separated browser origins allowed in addition to any localhost port.
# Leave unset for local development. Set it in production or the deployed client is rejected by CORS.
# CLIENT_ORIGIN="https://app.example.com"

# Optional. Defaults to 3000.
# PORT=3000

# Optional. NestJS Observe credentials from `npx @nestjs/observe link`.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
