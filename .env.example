# Copy to .env for local development. The app reads it via `nest start --env-file .env`.
# Production values belong in .env.production, which is gitignored.

# Local Prisma Postgres from `pnpm exec prisma dev -d`.
# 51214 is the app database. 51215 is the empty shadow database for `prisma migrate dev`.
# Prisma dev ignores the database name and always opens template1, so these names must stay template1.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Required. JwtAuthModule throws on startup when this is missing.
# Use a long random value. Do not commit the real secret.
JWT_SECRET="replace-with-a-long-random-string"

# Required. Lifetimes in seconds. src/env.validation.ts rejects a missing or non-integer value on startup.
# 900 is 15 minutes. 604800 is 7 days.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Optional. Comma-separated browser origins allowed in addition to any localhost port.
# Leave unset for local development. Set it in production or the deployed client is rejected by CORS.
# CLIENT_ORIGIN="https://app.example.com"

# Optional. Defaults to 3000.
# PORT=3000

# Optional. NestJS Observe credentials from `npx @nestjs/observe link`.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=

# Required to send contact messages through Resend. Do not commit the real key.
RESEND_API_KEY="re_replace_with_your_resend_key"
# Optional sender. Resend must have this domain verified.
# Without it, mail is sent from onboarding@resend.dev, which can only deliver to the Resend account owner.
# RESEND_FROM="Brett Brinkhoff <hello@your-domain.com>"

# .env.production uses the same names with Neon URLs:
# DATABASE_URL = pooled host (ends in -pooler) for the running API
# DIRECT_URL   = direct host for `pnpm prisma:deploy`
# Do not set SHADOW_DATABASE_URL in production. `migrate deploy` does not use a shadow database.
