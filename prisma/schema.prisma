generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid()) // Consider TSID
  firstName String
  lastName  String
  email     String   @unique
  password  String
  age       Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
